PAYLOAD_SECRET=
# Local development: a local SQLite file
DATABASE_URI=file:./payload.db
# Production (Turso / libSQL): set both vars
# DATABASE_URI=libsql://<your-db>-<your-org>.turso.io
# DATABASE_AUTH_TOKEN=<your-turso-token>
DATABASE_AUTH_TOKEN=

# Vercel Blob storage for media uploads (required in production on Vercel).
# Create a Blob store in Vercel dashboard -> Storage -> Blob, then copy the token.
# Without this, uploads fall back to the local filesystem (works only in dev).
BLOB_READ_WRITE_TOKEN=
